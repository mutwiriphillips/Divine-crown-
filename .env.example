# Copy to .env and fill in. Never commit .env. On a host (Vercel, Render, a VPS), set these in its
# environment settings instead. Only the first block is needed to run the shop locally.

# ── Required ──────────────────────────────────────────────────────────────
# Postgres connection string, e.g. postgres://user:password@host:5432/shop
DATABASE_URL=
# Public address of the site, no trailing slash (used in links, emails and receipts)
APP_URL=
# Random string, at least 32 characters (encrypts two-step sign-in secrets, signs tokens).
# Generate one with:  openssl rand -base64 48
APP_SECRET=
# Secret for the scheduled-task endpoint /api/cron/tick (sent as "Authorization: Bearer <secret>")
CRON_SECRET=

# ── Database options ──────────────────────────────────────────────────────
# Only for docker-compose.yml: password for the bundled Postgres container
POSTGRES_PASSWORD=
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=
DATABASE_POOL_MAX=
# Separate database for automated tests (its name must contain "test"; it is wiped on every run)
TEST_DATABASE_URL=

# ── M-Pesa (Safaricom Daraja) ─────────────────────────────────────────────
# simulator | sandbox | production. Leave empty to turn M-Pesa off.
# "simulator" fakes the customer's phone for development; it is refused in production
# unless ALLOW_PAYMENT_SIMULATOR=true (only ever for a private staging site).
MPESA_ENV=
ALLOW_PAYMENT_SIMULATOR=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill or till store number, and the Lipa na M-Pesa Online passkey from Safaricom
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till)
MPESA_TRANSACTION_TYPE=
# For tills: the till number that receives the money, if different from MPESA_SHORTCODE
MPESA_PARTY_B=
# Public HTTPS base URL Safaricom can reach, e.g. https://shop.example.co.ke
MPESA_CALLBACK_BASE_URL=
# Long random string; becomes part of the secret callback address
MPESA_CALLBACK_SECRET=
# Optional comma-separated list of Safaricom callback IP addresses to accept
MPESA_ALLOWED_IPS=

# ── Email (choose one) ────────────────────────────────────────────────────
EMAIL_FROM=
# Resend API key
RESEND_API_KEY=
# or any SMTP server, e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=

# ── SMS (Africa's Talking) ────────────────────────────────────────────────
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ── WhatsApp (Meta WhatsApp Business Cloud API) ───────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved message template for business-initiated messages
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=

# ── File storage ──────────────────────────────────────────────────────────
# local (default; files in STORAGE_DIR) or s3 (any S3-compatible service: AWS S3, Cloudflare R2, Spaces)
STORAGE_DRIVER=
STORAGE_DIR=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=

# ── Monitoring ────────────────────────────────────────────────────────────
# Optional webhook that receives a short message for each server error
ERROR_WEBHOOK_URL=

# ── Development only ──────────────────────────────────────────────────────
# Allow sign-in cookies over plain http (local testing on a LAN address). Never set in production.
INSECURE_COOKIES=
# Used once by "npm run create-owner"; remove afterwards
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=
# Folder of product photos for "npm run db:seed" (default ./seed-photos)
SEED_PHOTOS_DIR=
# Allow "npm run db:seed:demo" when NODE_ENV=production (staging only)
ALLOW_DEMO_SEED=
