{
  "name": "herbal-shop",
  "version": "1.0.0",
  "private": true,
  "description": "E-commerce and business management platform for a Kenyan herbal and traditional products retailer",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx scripts/worker.ts",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:purge-demo": "tsx scripts/purge-demo.ts",
    "db:backup": "bash scripts/backup.sh",
    "db:restore": "bash scripts/restore.sh",
    "create-owner": "tsx scripts/create-owner.ts",
    "test": "vitest run",
    "test:e2e": "tsx tests/e2e/run.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "next": "^15.5.28",
    "nodemailer": "^10.1.1",
    "papaparse": "^5.7.0",
    "pdfkit": "^0.15.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.64.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
